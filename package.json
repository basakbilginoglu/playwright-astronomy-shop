{
  "name": "playwright-astronomy-shop",
  "version": "1.0.0",
  "description": "End-to-end testing of OpenTelemetry Astronomy Shop using Playwright and TypeScript.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "e2e-testing",
    "observability"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}